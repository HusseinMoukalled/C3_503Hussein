# Get a free-tier Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Bonus review costs one extra request per turn. Set false to conserve free quota.
ENABLE_REFLECTION=true
# Default pacing supports a 5-request/minute project; tool + review calls count too.
MIN_REQUEST_INTERVAL_SECONDS=13
# Keep 127.0.0.1 locally; set 0.0.0.0 in Hugging Face Spaces variables.
SERVER_NAME=127.0.0.1
# BOT_LOG_DIR=/data/cedarloop-logs
